# ============================================================
# Bot — пример переменных окружения.
# Скопируй в .env, заполни.
# ============================================================

BOT_TOKEN=
BOT_USERNAME=ihuman_manager_bot
BOT_OWNER_USERNAME=

BACKEND_URL=http://localhost:8015
BACKEND_API_PREFIX=/api/v1

# Локальный кеш медиа (голос)
MEDIA_DIR=./data/media

LOG_LEVEL=INFO

# Период тика scheduler (сек). 0 = не запускать в боте.
BOT_SCHEDULER_TICK_SECONDS=300
