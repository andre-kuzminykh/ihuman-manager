# ============================================================
# iHuman Manager — пример переменных окружения
# Скопируй файл в .env и заполни значения.
# ============================================================

# ---- Telegram ----
# Токен бота (BotFather → /newbot → токен)
BOT_TOKEN=
# Username бота без @ (нужно для распознавания тегов в групповых чатах)
BOT_USERNAME=ihuman_manager_bot
# Username владельца бота — для DM (опционально, можно оставить пустым)
BOT_OWNER_USERNAME=

# ---- Backend (URL для бота) ----
BACKEND_URL=http://localhost:8015
BACKEND_API_PREFIX=/api/v1
# Внешний порт, на который docker мапит бэкенд (внутри контейнера всегда 8015)
BACKEND_PORT=8015

# ---- PostgreSQL ----
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=ihuman_manager

# Тестовая БД (CI/локальные тесты)
TEST_DB_HOST=localhost
TEST_DB_PORT=5432
TEST_DB_USER=postgres
TEST_DB_PASSWORD=postgres
TEST_DB_NAME=ihuman_manager_test

# ---- LLM / Speech ----
# OpenAI API key (gpt-4o-mini для extract, whisper-1 для голоса)
OPENAI_API_KEY=
# Двухступенчатый pipeline извлечения задач:
# 1) CLASSIFIER_MODEL — быстрый, отвечает «есть ли тут задача?»
# 2) DECOMPOSER_MODEL — мощный, разбивает сообщение на структурированные задачи.
# LLM_MODEL остаётся для llm-edit и legacy classify_message.
LLM_MODEL=gpt-4o-mini
CLASSIFIER_MODEL=gpt-4o-mini
DECOMPOSER_MODEL=gpt-5.4
WHISPER_MODEL=whisper-1

# ---- Scheduler ----
# Cron-выражение или интервал тика
SCHEDULER_TICK_SECONDS=300
MORNING_DIGEST_HOUR_MSK=9
DEFAULT_DEADLINE_HOUR_MSK=18

# ---- Logging ----
LOG_LEVEL=INFO
